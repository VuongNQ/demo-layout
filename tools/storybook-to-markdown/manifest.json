{
  "manifest_version": 3,
  "name": "Storybook to Markdown",
  "version": "0.2.0",
  "description": "Export current Storybook Docs or categorized Docs archives to Markdown and ZIP.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Storybook to Markdown"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
